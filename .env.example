# Copy this file to .env — the real .env is gitignored and must never be committed.

# OpenRouter API key (default gateway; one key, all models).
# Create one at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Vercel AI Gateway API key — only needed for `--gateway vercel`.
# Create one at: https://vercel.com/docs/ai-gateway → your team → AI Gateway → API keys.
# (Renamed from AI_GATEWAY_API_KEY — update your existing .env if you have one.)
VERCEL_AI_GATEWAY_API_KEY=

# Notion integration key — only needed for bank re-export (scripts/export_bank.py)
# and pushing run results to Notion (python -m mizan.export --notion).
NOTION_API_KEY=

# Data source id of the master "Mizan runs" Notion database. Printed by the one-time
# bootstrap: uv run python -m mizan.export --init-notion --parent-page-id <page-id>
NOTION_RUNS_DATA_SOURCE_ID=
